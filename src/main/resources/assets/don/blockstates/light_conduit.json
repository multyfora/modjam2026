    { "when": { "powered": false, "west": true }, "apply": { "model": "don:block/arm_west" } },
    { "when": { "powered": true, "west": true }, "apply": { "model": "don:block/arm_west_lit" } },

    { "when": { "powered": false, "up": true }, "apply": { "model": "don:block/arm_up" } },
